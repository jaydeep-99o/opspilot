# Copy this file to .env and fill in your key. .env is git-ignored; this file is safe to commit.
NEBIUS_API_KEY=your-nebius-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the exact ID on your account with: python run_local.py --list-models
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
